# --- Anthropic (story generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Pexels (free licensed stock footage for auto mode) ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# What the channel is about. Pick ONE specific niche and stick to it.
NICHE=mind-blowing true facts about history, nature, and science
# Keep above 60 — TikTok Creator Rewards only pays on videos over 1 minute.
TARGET_DURATION_SECONDS=75

# --- TikTok developer app (Content Posting API, video.publish scope) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY until your TikTok app is audited; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Behavior ---
ENABLE_VOICEOVER=true
ENABLE_UPLOAD=true
MAX_POSTS_PER_RUN=1
WATCH_INTERVAL_SECONDS=3600
FRAMES_PER_CLIP=6
TTS_VOICE=en-US-GuyNeural
STORY_STYLE=playful, witty, slightly absurd internet humor — like a friend narrating the clip with way too much enthusiasm

# --- Optional: free LLM via Groq instead of Claude (weaker writing quality) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=
