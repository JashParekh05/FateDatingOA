# --- Anthropic (story generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- TikTok developer app (Content Posting API, video.publish scope) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY until your TikTok app is audited; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Behavior ---
ENABLE_VOICEOVER=true
ENABLE_UPLOAD=true
MAX_POSTS_PER_RUN=1
WATCH_INTERVAL_SECONDS=3600
FRAMES_PER_CLIP=6
TTS_VOICE=en-US-GuyNeural
STORY_STYLE=playful, witty, slightly absurd internet humor — like a friend narrating the clip with way too much enthusiasm
